@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor User as user
actor "Email Validation Service" as emailSvc

rectangle "Sproutly" {

  (Create Account) as UC_Create
  (Login) as UC_Login
  (Manage Garden) as UC_Garden
  (Manage Plants) as UC_Plants

  (Verify Email Format) as UC_VerifyEmail
  (Verify Credentials) as UC_VerifyCreds
  (Authenticate User) as UC_Auth

  (Display Email Error) as UC_EmailErr
  (Display Invalid Credentials) as UC_CredErr

  (Add Plant) as UC_Add
  (Update Plant) as UC_Update
  (Remove Plant) as UC_Remove

  ' Actor relationships (primary)
  user --> UC_Create
  user --> UC_Login
  user --> UC_Garden

  ' Mandatory sub-behavior
  UC_Create ..> UC_VerifyEmail : <<include>>
  UC_Login  ..> UC_VerifyCreds : <<include>>
  UC_Garden ..> UC_Auth        : <<include>>

  ' Conditional behavior (extensions) - correct direction
  UC_EmailErr ..> UC_Create : <<extend>>
  UC_CredErr  ..> UC_Login  : <<extend>>

  ' Garden decomposition
  UC_Garden --> UC_Plants
  UC_Plants ..> UC_Add    : <<include>>
  UC_Plants ..> UC_Update : <<include>>
  UC_Plants ..> UC_Remove : <<include>>

  ' External service interaction
  emailSvc --> UC_VerifyEmail
  UC_VerifyEmail -[hidden]-> emailSvc

  note right of UC_Auth
  Precondition for protected features:
  User must be authenticated.
  end note
}

@enduml


